# Copie este archivo como .env (no se sube a Git) y complete los valores.
# docker compose lo lee automaticamente.

# Gmail: use una "contrasena de aplicacion" (https://myaccount.google.com/apppasswords),
# no la contrasena normal de la cuenta. Se escribe sin espacios.
SMTP_USERNAME=su_correo@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
SMTP_FROM_ADDRESS=su_correo@gmail.com
SMTP_FROM_NAME=Gestion de Usuarios

# Puerto del host para el MySQL de docker compose (cambielo si ya tiene MySQL local en 3306)
MYSQL_HOST_PORT=3306
